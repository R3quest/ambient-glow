<?xml version="1.0" encoding="utf-8"?>
<!-- The soak build only (make soak), never shipped. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- adb's test messages come from com.android.shell: the listener gets them either way (seen on
         Android 16), but reads the posting app's icon and label for the LED's colour, which needs
         the package visible. -->
    <queries>
        <package android:name="com.android.shell" />
    </queries>

    <application>
        <!-- Bright LED and Then from adb, for a run (scripts/soak.sh). DUMP: adb's shell has it, apps can't. -->
        <receiver
            android:name=".SoakSettings"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
