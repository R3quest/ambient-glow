    <string name="shield_label">Ambient Glow effects</string>
    <string name="shield_summary">Plays the new-message effect over the lock screen and hides the system bars while the LED turns the screen on.</string>
    <string name="shield_description">When a new message lights the lock screen, this service draws your chosen glow effect over it for two seconds; the lock screen stays visible and usable underneath. When the LED lights the screen, it also covers the battery icon and navigation handle with black for half a second. It reads no screen content and receives no accessibility events.</string>

    <string name="channel_name">Wake bridge</string>
    <string name="channel_description">Briefly used to light the screen when a message arrives. Dismissed automatically.</string>
