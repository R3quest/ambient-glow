    <string name="glass_area_screen">SCREEN</string>
    <string name="glass_area_reveal_body">The lock screen lights up frosted and the wave sweeps it clear, so your notifications swim out sharp behind it.</string>
    <string name="glass_area_wave_body">A frosted band rides under the crest: whatever it passes goes soft, then sharp again.</string>
    <string name="glass_area_screen_body">The whole screen frosts over as the wave rolls in, then clears as it leaves.</string>
    <string name="glass_area_fallback">Needs Android 12+. Where the blur can\'t follow the wave, the whole screen blurs.</string>
    <string name="glass_frost">FROST</string>
    <string name="glass_frost_off">OFF</string>
    <string name="glass_frost_soft">SOFT</string>
    <string name="glass_frost_milky">MILKY</string>
    <string name="glass_on_black">On a black screen there is nothing to blur: frost shows only where the wave\'s light catches it.</string>
