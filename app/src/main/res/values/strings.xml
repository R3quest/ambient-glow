    <string name="section_dot">LED DOT</string>
    <string name="group_arrival_title">New message</string>
    <string name="group_arrival_body">What plays the moment a message arrives, in the app\'s colour.</string>
    <string name="group_led_title">Waiting LED</string>
    <string name="group_led_body">Afterwards the screen goes black and only this dot blinks, one blink per waiting app, until you read or dismiss the messages.</string>
    <string name="effect_style">STYLE</string>
    <string name="effect_spawn_title">AirDrop spawn</string>
    <string name="effect_spawn_body">A wave of light bursts out of the camera and lights the glow as it passes.</string>
    <string name="effect_glass_title">Glass wave</string>
    <string name="effect_glass_body">The wave rolls in like water over glass: a soft, shimmering crest of light with a gentle ripple behind it.</string>
    <string name="glass_blur">BLUR UNDERNEATH</string>
    <string name="glass_blur_off">OFF</string>
    <string name="glass_blur_light">LIGHT</string>
    <string name="glass_blur_medium">MEDIUM</string>
