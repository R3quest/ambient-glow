    <string name="element_premium_mark">Premium</string>
    <string name="element_soon">Coming soon: it plays as the bare wave for now.</string>
    <string name="effects_off_title">Effects are off</string>
    <string name="effects_off_body">With Just the LED, new messages skip the effect and go straight to the dot. Pick a screen that plays an effect to style it here.</string>
