<?xml version="1.0" encoding="utf-8"?>
<!-- A gradient glow ring with an orbiting signal dot, inside the 66dp adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft outer halo -->
    <path
        android:pathData="M54,30 a24,24 0 1,1 0,48 a24,24 0 1,1 0,-48"
        android:strokeWidth="2"
        android:strokeAlpha="0.35"
        android:strokeColor="#00E5FF" />

    <!-- Main ring -->
    <path
        android:pathData="M54,35 a19,19 0 1,1 0,38 a19,19 0 1,1 0,-38"
        android:strokeWidth="6"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endColor="#FFFF2E93"
                android:endX="73"
                android:endY="73"
                android:startColor="#FF00E5FF"
                android:startX="35"
                android:startY="35"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Signal dot riding the ring at 1–2 o'clock -->
    <path
        android:fillColor="#FFB6FF3B"
        android:pathData="M67.4,34.6 m-5.5,0 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0" />
</vector>
