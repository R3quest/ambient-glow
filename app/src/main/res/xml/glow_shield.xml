<?xml version="1.0" encoding="utf-8"?>
<!-- No event types and no window content: the service only owns overlay windows (the effect, the LED's window, the
     always-on display's) and puts the phone to sleep when the LED has nothing left to show. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/shield_description"
    android:summary="@string/shield_summary"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="0" />
