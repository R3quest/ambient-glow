<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lights the panel for the length of one glow; always acquired with a timeout. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Bridge notification that carries the full-screen intent (Android 13+ runtime grant). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The only background-launch path Android allows without SYSTEM_ALERT_WINDOW. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Lets the listener load sender app icons and names for colour + card (Android 11+
         package visibility). Launcher apps only; no QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AmbientGlow"
        tools:targetApi="35">

        <!-- Portrait: LED positions, spots and the camera fit are saved as fractions of the
             portrait screen; worked out in landscape they would land elsewhere on the panel.
             Phones keep honouring it; only large screens may ignore it (Android 16+). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Never recreated: a recreate would replay its launch intent mid-session (uncover the
             lock screen, replay the effect). It draws only black and the LED, so it takes every
             change in place. No fixed orientation: its theme is translucent, and Android 8.0
             refuses translucent activities that fix one. -->
        <activity
            android:name=".WakeScreenActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|touchscreen|uiMode|density|fontScale|fontWeightAdjustment|locale|layoutDirection|colorMode|mcc|mnc"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.AmbientGlow.Wake" />
        <!-- showWhenLocked / turnScreenOn are switched at runtime: see WakeScreenActivity. -->

        <service
            android:name=".NotificationWakerService"
            android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <!-- Android 12+: the system never delivers ongoing or silent notifications to us,
                 so those posts cost zero wake-ups. -->
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting" />
            <meta-data
                android:name="android.service.notification.disabled_filter_types"
                android:value="ongoing|silent" />
        </service>

        <!-- Optional: covers the system bars while the LED takes over the screen (GlowShield). -->
        <service
            android:name=".GlowShield"
            android:exported="true"
            android:label="@string/shield_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/glow_shield" />
        </service>
    </application>
</manifest>
